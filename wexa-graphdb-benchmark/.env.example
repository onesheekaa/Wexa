# Copy this to .env and fill in real values. .env is gitignored - never
# commit real passwords or connection URIs (see assignment section 6).

# --- CognoDB Cloud (sign up at https://console.cognodb.com/signup) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Self-hosted Neo4j (docker compose, default port) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmarkpass123

# --- Self-hosted Memgraph (docker compose, mapped to host port 7688) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# --- Self-hosted ArangoDB ---
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=benchmarkpass123
ARANGO_DB=benchmark

# --- Self-hosted Dgraph (gRPC endpoint of the alpha node) ---
DGRAPH_GRPC=localhost:9080
